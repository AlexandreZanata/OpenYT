CREATE TABLE download_task (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    id TEXT NOT NULL UNIQUE,
    source_id TEXT NOT NULL,
    title TEXT NOT NULL,
    author TEXT,
    source TEXT NOT NULL,
    url TEXT NOT NULL,
    webpage_url TEXT NOT NULL,
    duration_seconds INTEGER,
    thumbnail_url TEXT,
    kind TEXT NOT NULL,
    format_id TEXT,
    destination_directory TEXT NOT NULL,
    status TEXT NOT NULL,
    percent REAL NOT NULL DEFAULT 0,
    speed_bytes_per_second INTEGER,
    eta_seconds INTEGER,
    file_path TEXT,
    size_bytes INTEGER,
    failure_kind TEXT,
    failure_detail TEXT,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s','now') * 1000),
    priority TEXT NOT NULL DEFAULT 'NORMAL',
    attempt INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE library_entry (
    id TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    author TEXT,
    kind TEXT NOT NULL,
    file_path TEXT NOT NULL,
    size_bytes INTEGER,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s','now') * 1000),
    thumbnail_url TEXT,
    source TEXT
);

CREATE TABLE collection (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    created_at INTEGER NOT NULL DEFAULT (strftime('%s','now') * 1000)
);

CREATE TABLE collection_entry (
    collection_id TEXT NOT NULL,
    entry_id TEXT NOT NULL,
    PRIMARY KEY (collection_id, entry_id)
);

CREATE TABLE app_settings (
    id INTEGER PRIMARY KEY CHECK (id = 1),
    theme_mode TEXT NOT NULL DEFAULT 'SYSTEM',
    language TEXT NOT NULL DEFAULT 'PT_BR',
    max_concurrent INTEGER NOT NULL DEFAULT 2,
    downloads_directory TEXT,
    storage_tree_uri TEXT,
    speed_limit_bytes_per_second INTEGER,
    download_window_start_minutes INTEGER,
    download_window_end_minutes INTEGER,
    organization_preset TEXT NOT NULL DEFAULT 'PLAYLIST',
    file_organization_template TEXT
);

selectSettings:
SELECT * FROM app_settings WHERE id = 1;

upsertSettings:
INSERT OR REPLACE INTO app_settings(
    id, theme_mode, language, max_concurrent, downloads_directory, storage_tree_uri,
    speed_limit_bytes_per_second, download_window_start_minutes, download_window_end_minutes,
    organization_preset, file_organization_template
)
VALUES (
    1, :theme_mode, :language, :max_concurrent, :downloads_directory, :storage_tree_uri,
    :speed_limit_bytes_per_second, :download_window_start_minutes, :download_window_end_minutes,
    :organization_preset, :file_organization_template
);

selectAllTasks:
SELECT * FROM download_task ORDER BY seq ASC;

insertTask:
INSERT OR REPLACE INTO download_task(
    id, source_id, title, author, source, url, webpage_url, duration_seconds,
    thumbnail_url, kind, format_id, destination_directory, status, percent,
    speed_bytes_per_second, eta_seconds, file_path, size_bytes,
    failure_kind, failure_detail, priority, attempt
) VALUES (
    :id, :source_id, :title, :author, :source, :url, :webpage_url, :duration_seconds,
    :thumbnail_url, :kind, :format_id, :destination_directory, :status, :percent,
    :speed_bytes_per_second, :eta_seconds, :file_path, :size_bytes,
    :failure_kind, :failure_detail, :priority, :attempt
);

updateTask:
UPDATE download_task SET
    status = :status,
    percent = :percent,
    speed_bytes_per_second = :speed_bytes_per_second,
    eta_seconds = :eta_seconds,
    file_path = :file_path,
    size_bytes = :size_bytes,
    failure_kind = :failure_kind,
    failure_detail = :failure_detail,
    priority = :priority,
    attempt = :attempt
WHERE id = :id;

deleteTask:
DELETE FROM download_task WHERE id = :id;

markActiveInterrupted:
UPDATE download_task
SET status = 'INTERRUPTED'
WHERE status IN ('QUEUED', 'DOWNLOADING', 'PROCESSING');

selectAllLibrary:
SELECT * FROM library_entry ORDER BY created_at DESC, id ASC;

insertLibraryEntry:
INSERT OR REPLACE INTO library_entry(id, title, author, kind, file_path, size_bytes, thumbnail_url, source)
VALUES (:id, :title, :author, :kind, :file_path, :size_bytes, :thumbnail_url, :source);

deleteLibraryEntry:
DELETE FROM library_entry WHERE id = :id;

CREATE TABLE library_tag (
    entry_id TEXT NOT NULL,
    tag TEXT NOT NULL,
    PRIMARY KEY (entry_id, tag)
);

CREATE TABLE smart_collection (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    query TEXT NOT NULL DEFAULT '',
    kind TEXT,
    tag TEXT,
    min_size_bytes INTEGER,
    max_size_bytes INTEGER,
    created_within_days INTEGER
);

selectAllSmartCollections:
SELECT * FROM smart_collection ORDER BY name ASC;

insertSmartCollection:
INSERT OR REPLACE INTO smart_collection(
    id, name, query, kind, tag, min_size_bytes, max_size_bytes, created_within_days
) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteSmartCollection:
DELETE FROM smart_collection WHERE id = ?;

selectAllLibraryTags:
SELECT entry_id, tag FROM library_tag ORDER BY tag ASC;

insertLibraryTag:
INSERT OR IGNORE INTO library_tag(entry_id, tag) VALUES (?, ?);

deleteLibraryTag:
DELETE FROM library_tag WHERE entry_id = ? AND tag = ?;

deleteLibraryTagsForEntry:
DELETE FROM library_tag WHERE entry_id = ?;

deleteCollectionEntriesForEntry:
DELETE FROM collection_entry WHERE entry_id = :entry_id;

selectAllCollections:
SELECT * FROM collection ORDER BY created_at ASC, id ASC;

insertCollection:
INSERT OR REPLACE INTO collection(id, name) VALUES (:id, :name);

deleteCollectionEntries:
DELETE FROM collection_entry WHERE collection_id = :collection_id;

deleteCollection:
DELETE FROM collection WHERE id = :id;

selectCollectionMembership:
SELECT collection_id, entry_id FROM collection_entry;

insertCollectionEntry:
INSERT OR IGNORE INTO collection_entry(collection_id, entry_id)
VALUES (:collection_id, :entry_id);

deleteCollectionEntry:
DELETE FROM collection_entry WHERE collection_id = :collection_id AND entry_id = :entry_id;
