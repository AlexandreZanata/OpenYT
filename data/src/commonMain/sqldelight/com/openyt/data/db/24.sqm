CREATE TABLE portable_operation (
    id TEXT NOT NULL PRIMARY KEY,
    direction TEXT NOT NULL,
    status TEXT NOT NULL,
    bundle_id TEXT,
    archive_locator TEXT NOT NULL,
    archive_sha256 TEXT,
    destination_root TEXT,
    staging_dir TEXT,
    total_bytes INTEGER NOT NULL DEFAULT 0,
    completed_bytes INTEGER NOT NULL DEFAULT 0,
    entries_total INTEGER NOT NULL DEFAULT 0,
    entries_done INTEGER NOT NULL DEFAULT 0,
    plan_json TEXT,
    error TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX portable_operation_status_idx ON portable_operation(status, updated_at);
